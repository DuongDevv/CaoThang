@model NguyenQuocDuong_102_De01.WebUI.Models.ProductListViewModel

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="row">
    <div class="col-md-3">
        @await Component.InvokeAsync("NavigationMenu")
    </div>

    <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold mb-0 text-secondary">
                Danh Sách Sản Phẩm
            </h4>
            <span class="badge bg-info text-dark fs-6">
                Tổng cộng: @Model.PagingInfo.TotalItems sản phẩm
            </span>
        </div>

        @if (!Model.Products.Any())
        {
            <div class="alert alert-warning text-center my-4" role="alert">
                Không tìm thấy sản phẩm nào thuộc danh mục này!
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
                @foreach (var p in Model.Products)
                {
                    <div class="col">
                        @await Html.PartialAsync("_ProductCard", p)
                    </div>
                }
            </div>

            @if (Model.PagingInfo.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= Model.PagingInfo.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PagingInfo.CurrentPage ? "active" : "")">
                                <a class="page-item page-link" 
                                   asp-controller="Product" 
                                   asp-action="List" 
                                   asp-route-categoryId="@Model.CurrentCategory" 
                                   asp-route-page="@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
    </div>
</div>
