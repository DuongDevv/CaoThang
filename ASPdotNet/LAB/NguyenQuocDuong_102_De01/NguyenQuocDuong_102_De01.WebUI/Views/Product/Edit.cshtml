@model NguyenQuocDuong_102_De01.Domain.Product

@{
    ViewData["Title"] = Model.ProductID == 0 ? "Thêm mới sản phẩm" : "Chỉnh sửa sản phẩm";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-bold fs-5">
                @(Model.ProductID == 0 ? "THÊM MỚI SẢN PHẨM" : $"CHỈNH SỬA SẢN PHẨM #{Model.ProductID}")
            </div>
            <div class="card-body p-4">
                <form asp-controller="Product" asp-action="Edit" method="post">
                    <input type="hidden" asp-for="ProductID" />

                    <!-- Validation Summary -->
                    <div asp-validation-summary="All" class="text-danger mb-3 font-weight-bold"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-bold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                            <input asp-for="Price" type="number" step="1000" class="form-control" placeholder="Nhập giá..." />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-bold">Danh mục sản phẩm <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                                <option value="">-- Chọn Danh Mục --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImageUrl" class="form-label fw-bold">Đường dẫn Hình ảnh (URL)</label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold">Mô tả sản phẩm</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập mô tả chi tiết sản phẩm..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="Product" asp-action="List" class="btn btn-outline-secondary">
                            Quay lại Danh sách
                        </a>
                        <button type="submit" class="btn btn-primary fw-bold px-4">
                            Lưu Sản Phẩm
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
