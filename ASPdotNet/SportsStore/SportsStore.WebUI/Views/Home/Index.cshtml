@using SportsStore.WebUI.Models
@model ProductsListViewModel
@{
    ViewData["Title"] = "Trang chủ - SportsStore";
}

<div class="row">
    @foreach (var p in Model.Products)
    {
        <div class="col-md-4 col-sm-6 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/football.png" : p.ImageUrl)" 
                     class="card-img-top p-3" alt="@p.Name" style="height: 200px; object-fit: contain;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title d-flex justify-content-between align-items-center">
                        <span>@p.Name</span>
                        <span class="badge bg-success rounded-pill">
                            @p.Price.ToString("c")
                        </span>
                    </h5>
                    <p class="card-text text-muted flex-grow-1">@p.Description</p>
                    <span class="badge bg-secondary mb-2 align-self-start">@p.Category</span>
                </div>
                <div class="card-footer text-center bg-white border-0 pb-3">
                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                        <input type="hidden" name="productId" value="@p.ProductID" />
                        <input type="hidden" name="returnUrl" value="@ViewContext.HttpContext.Request.PathAndQuery()" />
                        <button type="submit" class="btn btn-primary w-100">
                            Thêm vào giỏ hàng
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<div class="d-flex justify-content-end mt-3 mb-4">
    <div page-model="@Model.PagingInfo" 
         page-action="Index" 
         page-category="@Model.CurrentCategory"
         class="btn-group">
    </div>
</div>
