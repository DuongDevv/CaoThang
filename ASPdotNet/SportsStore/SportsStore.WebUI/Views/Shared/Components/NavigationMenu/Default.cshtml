@model IEnumerable<string>

<div class="d-grid gap-2">
    <a asp-controller="Home" asp-action="Index" asp-route-category="" 
       class="btn @(string.IsNullOrEmpty(ViewBag.SelectedCategory as string) ? "btn-primary" : "btn-outline-secondary")">
        Tất cả sản phẩm
    </a>

    @foreach (string category in Model)
    {
        <a asp-controller="Home" 
           asp-action="Index" 
           asp-route-category="@category" 
           asp-route-productPage="1"
           class="btn @(category == (ViewBag.SelectedCategory as string) ? "btn-primary" : "btn-outline-secondary")">
            @category
        </a>
    }
</div>
