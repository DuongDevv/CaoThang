<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SportsStore</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold fs-4 text-warning" asp-controller="Home" asp-action="Index">SPORTS STORE</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Cửa hàng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Index">Quản lý (Admin)</a>
                        </li>
                    </ul>
                    <div class="d-flex">
                        <a class="btn btn-outline-light" asp-controller="Cart" asp-action="Index">
                            🛒 Giỏ hàng
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 mt-4 flex-grow-1">
        <div class="row">
            @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home")
            {
                <aside class="col-md-3 col-lg-2 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-header bg-secondary text-white fw-bold">
                            Danh mục sản phẩm
                        </div>
                        <div class="card-body p-2">
                            @await Component.InvokeAsync("NavigationMenu")
                        </div>
                    </div>
                </aside>
                <main class="col-md-9 col-lg-10">
                    @RenderBody()
                </main>
            }
            else
            {
                <main class="col-12">
                    @RenderBody()
                </main>
            }
        </div>
    </div>

    <footer class="bg-dark text-white text-center py-3 mt-auto">
        <div class="container">
            <small>&copy; 2026 SportsStore - Đồ án Lập trình ASP.NET Core (Học phần 3611410)</small>
        </div>
    </footer>

    <script src="~/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
