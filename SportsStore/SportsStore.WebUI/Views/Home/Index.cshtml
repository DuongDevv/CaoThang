@* SportsStore.WebUI/Views/Home/Index.cshtml *@
@* 1. Khai báo model mà View này sẽ nhận: một danh sách các sản phẩm *@
@using SportsStore.Domain
@using SportsStore.WebUI.Models
@model ProductsListViewModel 
@{
    ViewData["Title"] = "Products";
}
<h2 class="text-center my-4">Product List</h2>

<div class="row">
    @* 2. Dùng vòng lặp foreach để duyệt qua từng sản phẩm trong Model *@
    @foreach (var p in Model.Products)
    {
        <div class="col-md-4 col-sm-6 mb-4">
            <div class="card h-100">
                @* Giả sử chúng ta sẽ có ảnh trong wwwroot/images *@
                <img src="@p.ImageUrl" class="card-img-top" alt="@p.Name" style="height: 200px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title">
                        @p.Name
                        <span class="badge bg-primary float-end">@p.Price.ToString("c")</span>
                    </h5>
                    <p class="card-text">@p.Description</p>
                </div>
            </div>
        </div>
    }
</div>
